<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings for the "XPlat Code Coverage" collector.
  Use with: dotnet test [collect flag] [settings flag] pointing here.

  Policy is 100% line and branch coverage with no exclusions. The filters below
  are NOT policy exclusions: they remove code nobody wrote. Without them the
  report counts the GeneratedRegex source generator output (one generated runner
  class alone is 120 lines of state machine) and Avalonia XamlClosure types
  emitted by the XAML compiler, neither of which can be meaningfully covered by
  a hand written test.

  Everything a human wrote in ClaudeCodeSpeaketh is measured.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!-- Compiler- and generator-emitted code. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute,DebuggerNonUserCodeAttribute</ExcludeByAttribute>

          <!-- Anything under obj/ is generated by the build, not source. -->
          <ExcludeByFile>**/obj/**/*.cs,**/*.g.cs,**/*.g.i.cs</ExcludeByFile>

          <!-- Measure the app only; the test assembly is not the subject. -->
          <Include>[ClaudeCodeSpeaketh]*</Include>
          <Exclude>[ClaudeCodeSpeaketh.Tests]*,[xunit.*]*</Exclude>

          <SingleHit>false</SingleHit>
          <UseSourceLink>false</UseSourceLink>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
